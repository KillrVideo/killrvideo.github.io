  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/KillrVideo/killrvideo.github.io/issues"
  },
  "homepage": "https://killrvideo.github.io",
  "private": true,
  "devDependencies": {
    "@11ty/eleventy": "^2.0",
    "cheerio": "^0.20.0",
    "eleventy-sass": "^2.0",
    "fast-glob": "^3.0",
    "highlight.js": "^11.0.0",
    "js-yaml": "^3.6.1",
    "markdown-it": "^13.0",
    "markdown-it-anchor": "^8.0",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "bulma": "^0.1.0",
    "font-awesome": "^4.6.3"
  }
