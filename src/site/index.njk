<section class="hero hero-home has-text-centered">
  <div class="hero-body">
    <div class="container">
      <h1 class="title is-1">Learn to build applications</h1>
      <p class="subtitle is-3">
        with DataStax Astra DB
      </p>
    </div>
  </div>
</section>
<section class="section is-medium has-text-centered">
  <div class="container">
    <div class="columns is-8 is-offset-2">
      <div class="column">
        <h2 class="title is-2">What is KillrVideo?</h2>
        <p class="subtitle is-4">
          KillrVideo is a reference application for developers looking to learn how to build applications with
          <a href="https://www.datastax.com/products/datastax-astra" target="_blank">DataStax Astra DB</a> and the
          <a href="https://docs.datastax.com/en/astra-db-serverless/databases/data-api.html" target="_blank">Data API</a>.
        </p>
        <a href="{{ nav.getting_started }}" class="button is-primary is-large">
          <i class="fa fa-code fa-fw"></i> Get Started
        </a>
      </div>
    </div>

    <hr class="hr" />

    <div class="tile is-ancestor is-parent">
      <div class="tile is-4 is-child flex-card">
        <h4 class="title is-4 flex-card-header">Astra DB + Data API</h4>
        <div class="content flex-card-content">
          <p>
            Build on DataStax Astra DB using the JSON Data API. Learn partition key design,
            SAI indexes, and data modeling patterns through real endpoint implementations.
          </p>
        </div>
        <div class="flex-card-footer">
          <a class="button is-medium is-success" href="{{ nav.concepts }}">
            Concepts
          </a>
        </div>
      </div>
      <div class="tile is-4 is-child flex-card">
        <h4 class="title is-4 flex-card-header">AI-Ready</h4>
        <div class="content flex-card-content">
          <p>
            Vector search, NVIDIA embeddings, and semantic search built in. Learn how to add
            AI-powered features to your application with Astra DB's vector capabilities.
          </p>
        </div>
        <div class="flex-card-footer">
          <a class="button is-medium is-success" href="{{ nav.services }}">
            Services
          </a>
        </div>
      </div>
      <div class="tile is-4 is-child flex-card">
        <h4 class="title is-4 flex-card-header">Agent-Friendly</h4>
        <div class="content flex-card-content">
          <p>
            Designed for both human developers and AI coding agents. Every endpoint includes
            downloadable spec artifacts and the site publishes an <code>llms.txt</code> index.
          </p>
        </div>
        <div class="flex-card-footer">
          <a class="button is-medium is-success" href="/llms.txt">
            llms.txt
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
